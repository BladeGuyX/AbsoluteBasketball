<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AB</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- Steamworks.NET 2025.164.1 (standalone, Windows x64) — multiplayer pela Steam (Etapa 5). -->
  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>ThirdParty\Steamworks\Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="ThirdParty\Steamworks\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
